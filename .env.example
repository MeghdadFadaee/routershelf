# Copy to .env and edit privately. The supervisor sources this as trusted shell code.
# Keep simple KEY=value assignments; no commands. Never commit your real .env.
RS_DOMAIN=files.example.com
RS_LAN_IP=192.168.50.1
RS_LAN_SUBNET=192.168.50.0/24
RS_LAN_INTERFACE=br0
RS_USB_MOUNT=/media/DISK_ID
RS_PUBLIC_SUBDIR=public-storage
RS_SERVICE_SUBDIR=.public-share-service
RS_HTTP_PORT=10080
RS_HTTPS_PORT=10443
# false restricts the service to LAN sources; true admits forwarded public traffic.
RS_PUBLIC_ACCESS=false
RS_DROP_PRIVILEGES=true
RS_MEMORY_LIMIT=32MiB
RS_CPU_LIMIT=2
RS_CHECK_INTERVAL=10
RS_MIN_YEAR=2026
RS_NTP_SERVER1=time.cloudflare.com
RS_NTP_SERVER2=pool.ntp.org
RS_SUPERVISOR_PATH=/etc/storage/public-share-service.sh
RS_RUNTIME_DIR=/tmp
# Optional absolute overrides; normally derive these from USB mount/subdirectories.
# RS_ROOT=/media/DISK_ID/public-storage
# RS_BINARY=/media/DISK_ID/.public-share-service/public-directory
# RS_CERT_CACHE=/media/DISK_ID/.public-share-service/certificates
# RS_CA_BUNDLE=/media/DISK_ID/.public-share-service/ca-certificates.pem
# Gateway values are for the NAT plan only; the supervisor does not change MikroTik.
RS_GATEWAY_LAN_IP=192.168.50.2
RS_GATEWAY_PUBLIC_IP=203.0.113.10
RS_GATEWAY_LAN_INTERFACE=ether1
RS_GATEWAY_WAN_INTERFACE=pppoe-out1
RS_PUBLIC_HTTP_PORT=80
RS_PUBLIC_HTTPS_PORT=443
RS_PUBLIC_SSH_PORT=222
RS_SSH_TARGET_PORT=22
