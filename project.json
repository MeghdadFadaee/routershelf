{
  "name": "routershelf",
  "displayName": "RouterShelf",
  "description": "Public read-only HTTP/HTTPS sharing and independent authenticated private SMB access to selected USB storage on constrained Linux routers.",
  "status": "experimental",
  "license": "MIT",
  "language": "Go",
  "minimumGoVersion": "1.26.0",
  "testedGoVersion": "1.26.5",
  "entrypoint": "cmd/routershelf",
  "documentation": "README.md",
  "topics": [
    "router",
    "file-sharing",
    "https",
    "directory-listing",
    "padavan",
    "mikrotik",
    "nais",
    "static-site",
    "smb",
    "finder",
    "exfat"
  ],
  "testedTarget": {
    "hardware": "Neterbit NW-651D",
    "architecture": "linux/mipsle",
    "kernel": "3.4.113",
    "firmware": "Padavan-derived",
    "busybox": "1.24.2"
  },
  "repository": null,
  "homepage": null,
  "configuration": ".env.example",
  "services": {
    "web": {
      "entrypoint": "cmd/routershelf",
      "configuration": ".env.example",
      "access": "public unauthenticated read-only",
      "targetStatus": "observed; see docs/deployment-history.md",
      "documentation": "docs/getting-started.md"
    },
    "smb": {
      "entrypoint": "cmd/routershelf-smb",
      "configuration": ".smb.example.json",
      "access": "private authenticated; read-only by default",
      "targetStatus": "experimental; target smoke checks observed; see docs/smb-validation.md",
      "documentation": "docs/smb.md"
    }
  }
}
